#!/usr/bin/env python3
"""Profile-scoped model diagnostics. Human approval and pairing are not CLI methods."""
import argparse
import json
import os
from pathlib import Path
from configuration import CompanionConfig
from scope import ScopedBridge

p = argparse.ArgumentParser()
p.add_argument('method', choices=['session.archiveStatus', 'session.archive', 'session.restore', 'system.capabilities', 'task.list', 'task.get', 'session.snapshot', 'run.submit', 'task.accept', 'task.pause', 'task.stop'])
p.add_argument('--profile-home', type=Path, default=Path(os.environ['HERMES_HOME']) if os.environ.get('HERMES_HOME') else Path(__file__).resolve().parents[2])
p.add_argument('--json', default='{}', dest='payload')
a = p.parse_args()
try:
    c = CompanionConfig.load(a.profile_home)
    print(json.dumps(ScopedBridge(c).call(c.credentials, a.method, json.loads(a.payload)), ensure_ascii=False))
except Exception as exc:
    p.exit(1, str(exc) + '\n')
